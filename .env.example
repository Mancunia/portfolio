# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-32-byte-hex-secret

# Admin password (bcrypt hash) — generate with:
# node -e "const b=require('bcryptjs'); b.hash('yourpassword',12).then(console.log)"
# Or set this in the admin_config table in Supabase instead.
ADMIN_PASSWORD_HASH=
