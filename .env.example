# Copy this file to .env.local and fill in your values.

# ── identity ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_OWNER_NAME="Your Name"
NEXT_PUBLIC_OWNER_TITLE="Your title"
NEXT_PUBLIC_OWNER_LOCATION="City · remote"
NEXT_PUBLIC_OWNER_EMAIL="you@example.com"
NEXT_PUBLIC_OWNER_BLURB="A short bio that appears under your name."
NEXT_PUBLIC_PORTRAIT_TONE="#3a4a4a"

# ── social links ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_GITHUB_HANDLE="yourusername"
NEXT_PUBLIC_GITHUB_URL="https://github.com/yourusername"
NEXT_PUBLIC_LINKEDIN_HANDLE="in/yourusername"
NEXT_PUBLIC_LINKEDIN_URL="https://www.linkedin.com/in/yourusername"

# ── site metadata (optional — defaults derived from identity above) ────────────
# NEXT_PUBLIC_SITE_TITLE="Your Name — Portfolio"
# NEXT_PUBLIC_SITE_DESCRIPTION="Your title · City · remote"

# ── supabase (required for dynamic content) ───────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── auth ──────────────────────────────────────────────────────────────────────
# generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-32-byte-hex-secret

# ── admin password (bcrypt hash) ──────────────────────────────────────────────
# generate with: node -e "require('bcryptjs').hash('yourpassword',12).then(console.log)"
ADMIN_PASSWORD_HASH=
